{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/block-playwright-cli.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash hooks/enforce-make-dev.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
